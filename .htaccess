# Portal Moeda Social — Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS e domínio canônico sem www
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Bloqueia arquivos e pastas internas
    RewriteRule ^(app|content|cron|storage|vendor|\.git)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule ^(composer\.(json|lock)|README\.md|DEPLOY\.md|.*\.sqlite.*)$ - [F,L]

    # Arquivos estáticos existentes são servidos diretamente; o resto vai para o roteador
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/markdown application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>
